{%- comment -%}
  Product page feature cards ("How it's built"). Each card has its own photo; with no photo the card shows text only.
{%- endcomment -%}
<section class="rdb-cards"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handle }}"{% endif %}>
  <div class="of-container">
    <div class="rdb-cards__head" data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="of-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="of-display of-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.intro != blank -%}
        <p class="rdb-cards__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </div>
    <div class="rdb-cards__grid">
      {%- for block in section.blocks -%}
        <div class="rdb-card" {{ block.shopify_attributes }} data-reveal>
          {%- render 'rdb-image', image: block.settings.image, placeholder: block.settings.placeholder, alt: block.settings.alt, ratio_w: 4, ratio_h: 3, sizes: '(min-width: 901px) 25vw, (min-width: 601px) 50vw, 100vw' -%}
          <div class="rdb-card__body">
            <h3 class="rdb-card__title">{{ block.settings.title }}</h3>
            <p class="rdb-card__text">{{ block.settings.text }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product feature cards",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How it's built" },
    { "type": "textarea", "id": "intro", "label": "Intro" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "how-its-built", "info": "Links to /products/radio-dry-bag#how-its-built jump here" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Feature card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "alt", "label": "Photo description (alt text)" },
        { "type": "text", "id": "placeholder", "label": "Placeholder label (theme editor only)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Feature" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Product feature cards" }]
}
{% endschema %}
