{%- comment -%}
  Product page top section: photo gallery + launch-list signup (no price, no buy button).
{%- endcomment -%}
{%- liquid
  assign visible = 0
  for block in section.blocks
    if block.settings.image != blank or request.design_mode
      assign visible = visible | plus: 1
    endif
  endfor
  assign rw = 4
  assign rh = 5
  if section.settings.ratio == 'square'
    assign rw = 1
    assign rh = 1
  endif
-%}
<section class="rdb-hero{% if visible == 0 %} rdb-hero--text-only{% endif %}" id="rdb-hero-{{ section.id }}">
  <div class="of-container of-container--wide rdb-hero__inner">
    {%- if visible > 0 -%}
      <div class="rdb-hero__gallery">
        <div class="rdb-hero__main">
          {%- assign n = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.image != blank or request.design_mode -%}
              {%- if n == 0 -%}{%- assign load = 'eager' -%}{%- else -%}{%- assign load = 'lazy' -%}{%- endif -%}
              <div class="rdb-hero__slide{% if n == 0 %} is-active{% endif %}" data-rdb-slide="{{ n }}" {{ block.shopify_attributes }}>
                {%- render 'rdb-image', image: block.settings.image, placeholder: block.settings.placeholder, alt: block.settings.alt, ratio_w: rw, ratio_h: rh, position: block.settings.position, sizes: '(min-width: 901px) 50vw, 100vw', loading: load -%}
              </div>
              {%- assign n = n | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if visible > 1 -%}
          <div class="rdb-hero__thumbs" aria-label="Product photos">
            {%- assign n = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.settings.image != blank or request.design_mode -%}
                <button type="button" class="rdb-hero__thumb{% if n == 0 %} is-active{% endif %}" data-rdb-thumb="{{ n }}" aria-label="Show photo {{ n | plus: 1 }}" aria-pressed="{% if n == 0 %}true{% else %}false{% endif %}">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
                  {%- else -%}
                    <span class="rdb-hero__thumb-ph">{{ n | plus: 1 }}</span>
                  {%- endif -%}
                </button>
                {%- assign n = n | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="rdb-hero__text">
      {%- if section.settings.model_label != blank -%}
        <p class="rdb-hero__model">{{ section.settings.model_label }}</p>
      {%- endif -%}
      <h1 class="of-display rdb-hero__title">{{ section.settings.heading | default: product.title }}</h1>
      <div class="of-rule"></div>
      {%- if section.settings.subheading != blank -%}
        <p class="of-lede rdb-hero__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.signup_label != blank -%}
        <p class="rdb-hero__cta-label">{{ section.settings.signup_label }}</p>
      {%- endif -%}
      {%- form 'customer', id: 'launch-signup-product', class: 'rdb-form' -%}
        {%- if form.posted_successfully? -%}
          <p class="rdb-form__success" role="status">{{ section.settings.signup_success | default: "You're on the list. We'll email you as soon as preorders open." }}</p>
        {%- else -%}
          <input type="hidden" name="contact[tags]" value="newsletter,launch-list">
          <div class="rdb-form__row">
            <label for="RdbLaunchEmail" class="of-visually-hidden">Email address</label>
            <input id="RdbLaunchEmail" class="rdb-form__input" type="email" name="contact[email]" placeholder="Email address" autocomplete="email" autocapitalize="off" spellcheck="false" required{% if form.errors %} aria-invalid="true" aria-describedby="RdbLaunchError"{% endif %}>
            <button type="submit" class="of-btn of-btn--primary rdb-form__submit">{{ section.settings.signup_button | default: 'Notify Me' }}</button>
          </div>
          {%- if form.errors -%}
            <p id="RdbLaunchError" class="rdb-form__error" role="alert">{{ form.errors | default_errors }}</p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
      {%- if section.settings.signup_note != blank -%}
        <p class="rdb-form__note">{{ section.settings.signup_note }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('rdb-hero-{{ section.id }}');
    if (!root) return;
    function show(i) {
      i = String(i);
      root.querySelectorAll('[data-rdb-slide]').forEach(function (s) { s.classList.toggle('is-active', s.getAttribute('data-rdb-slide') === i); });
      root.querySelectorAll('[data-rdb-thumb]').forEach(function (b) {
        var on = b.getAttribute('data-rdb-thumb') === i;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
    }
    root.addEventListener('click', function (e) {
      var t = e.target.closest('[data-rdb-thumb]');
      if (t) show(t.getAttribute('data-rdb-thumb'));
    });
    document.addEventListener('shopify:block:select', function (e) {
      var s = e.target.closest && e.target.closest('[data-rdb-slide]');
      if (s && root.contains(s)) show(s.getAttribute('data-rdb-slide'));
    });
  })();
</script>

{% schema %}
{
  "name": "Product top",
  "settings": [
    { "type": "text", "id": "model_label", "label": "Small label", "default": "Model RDB01" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "The Radio Dry Bag" },
    { "type": "textarea", "id": "subheading", "label": "Subheadline", "default": "Built for ocean rescue. Ready for anyone who needs their radio working after the waves hit." },
    { "type": "text", "id": "signup_label", "label": "Label above the email field", "default": "Launching Spring 2027. Get notified at launch." },
    { "type": "text", "id": "signup_button", "label": "Button text", "default": "Notify Me" },
    { "type": "text", "id": "signup_note", "label": "Small text under the field", "default": "Be first in line when preorders open." },
    { "type": "text", "id": "signup_success", "label": "Success message", "default": "You're on the list. We'll email you as soon as preorders open." },
    {
      "type": "select", "id": "ratio", "label": "Main photo shape", "default": "portrait",
      "options": [ { "value": "portrait", "label": "Portrait (4:5)" }, { "value": "square", "label": "Square" } ]
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "alt", "label": "Photo description (alt text)" },
        {
          "type": "select", "id": "position", "label": "Crop focus", "default": "center center",
          "options": [
            { "value": "center center", "label": "Center" },
            { "value": "center top", "label": "Top" },
            { "value": "center bottom", "label": "Bottom" },
            { "value": "left center", "label": "Left" },
            { "value": "right center", "label": "Right" }
          ]
        },
        { "type": "text", "id": "placeholder", "label": "Placeholder label (theme editor only)" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Product top" }]
}
{% endschema %}
