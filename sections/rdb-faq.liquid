{%- comment -%}
  Product page FAQ accordion (native details/summary, no script needed).
{%- endcomment -%}
<section class="rdb-faq">
  <div class="of-container">
    <h2 class="of-display of-h2" data-reveal>{{ section.settings.heading }}</h2>
    <div class="rdb-faq__list">
      {%- for block in section.blocks -%}
        <details class="rdb-faq__item" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="rdb-faq__answer"><p>{{ block.settings.answer | newline_to_br }}</p></div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "FAQ" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "textarea", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [{ "name": "Product FAQ" }]
}
{% endschema %}
