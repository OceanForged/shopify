{%- comment -%} Structured data (schema.org JSON-LD) so Google can read the store and product pages. {%- endcomment -%}
{%- if request.page_type == 'index' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ settings.og_site_name | default: shop.name | json }},
  "url": {{ shop.url | append: '/' | json }},
  "logo": {{ 'logo-dark.png' | file_url | prepend: 'https:' | json }},
  "email": "info@oceanforgedgear.com"
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ settings.og_site_name | default: shop.name | json }},
  "url": {{ shop.url | append: '/' | json }}
}
</script>
{%- elsif request.page_type == 'product' -%}
{%- assign sd_variant = product.selected_or_first_available_variant -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ shop.url | append: product.url | json }},
  {%- if product.images.size > 0 %}
  "image": [
    {%- for image in product.images limit: 6 -%}
      {{ image | image_url: width: 1600 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  {%- endif %}
  "description": {{ page_description | default: product.description | strip_html | strip_newlines | truncate: 500 | json }},
  {%- if sd_variant.sku != blank %}
  "sku": {{ sd_variant.sku | json }},
  {%- endif %}
  "brand": { "@type": "Brand", "name": "Ocean Forged" }
  {%- if product.available %},
  "offers": {
    "@type": "Offer",
    "url": {{ shop.url | append: sd_variant.url | json }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": {{ sd_variant.price | divided_by: 100.0 | json }},
    "availability": "https://schema.org/InStock",
    "itemCondition": "https://schema.org/NewCondition"
  }
  {%- endif %}
}
</script>
{%- endif -%}
