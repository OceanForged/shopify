<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="google-site-verification" content="Hbg0deCI27oG2xVw1IuP5uyoiNSIB-k4fUxOE_6CX3Y" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- liquid
      # Titles and descriptions come from Shopify (Online Store > Preferences for the homepage, and each page/product's SEO fields).
      # The theme settings below are only a fallback when the homepage has no title or description set in Preferences.
      assign seo_title = page_title
      assign seo_description = page_description
      if request.page_type == 'index'
        if page_title == shop.name and settings.home_seo_title != blank
          assign seo_title = settings.home_seo_title
        endif
        if seo_description == blank and settings.home_seo_description != blank
          assign seo_description = settings.home_seo_description
        endif
      endif
      assign brand_name = settings.og_site_name | default: shop.name
    -%}
    <title>
      {{- seo_title }}{% if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif %}{% unless seo_title contains brand_name %} &ndash; {{ brand_name }}{% endunless -%}
    </title>

    {% if seo_description != blank %}
      <meta name="description" content="{{ seo_description | escape }}">
    {% endif %}

    {% render 'meta-tags', seo_title: seo_title, seo_description: seo_description %}
    {% render 'structured-data' %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800;900&family=League+Spartan:wght@400;500;600;700&display=swap" rel="stylesheet">

    {{ 'base.css' | asset_url | stylesheet_tag }}

    {%- style -%}
      :root {
        --of-deep: {{ settings.color_deep | default: '#15302f' }};
        --of-deeper: {{ settings.color_deeper | default: '#0f2423' }};
        --of-orange: {{ settings.color_accent | default: '#E03F1A' }};
        --of-light: {{ settings.color_light | default: '#f2f5f4' }};
        --of-page-max: {{ settings.page_width | default: 1280 }}px;
      }
    {%- endstyle -%}

    {{ content_for_header }}
  </head>

  <body class="template-{{ request.page_type | handle }}">
    <a class="of-visually-hidden" href="#MainContent">{{ 'accessibility.skip_to_content' | t | default: 'Skip to content' }}</a>

    {% section 'header' %}

    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    {% render 'cart-drawer' %}

    {{ 'theme.js' | asset_url | script_tag }}
  </body>
</html>
